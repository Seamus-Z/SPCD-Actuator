build --enable_workspace
build --cpu=stm32g4
build --platforms=@com_github_mjbots_rules_mbed//:stm32g4
build --incompatible_enable_cc_toolchain_resolution
build --compiler=compiler
build --nostart_end_lib
build -c opt
build --stamp

# Host builds (unit tests): override the stm32g4 cross platform.
build:host --platforms=@local_config_platform//:host

# All tests run on the host (there are no on-target tests).
test --config=host
